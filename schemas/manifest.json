{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ALink 0.1 manifest",
  "type": "object",
  "properties": {
    "format": {
      "const": "alink.session"
    },
    "version": {
      "const": "0.1.0"
    },
    "captured_at": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "native_format": {
          "type": "string"
        },
        "app_version": {
          "type": "string"
        },
        "location": {
          "type": "string"
        }
      },
      "required": [
        "app",
        "native_format"
      ],
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": {
        "project": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "directory",
                "remote",
                "workspace_file"
              ]
            },
            "native_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "uri": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "path",
            "kind"
          ]
        }
      }
    },
    "streams": {
      "type": "object",
      "properties": {
        "events": {
          "const": "events.jsonl"
        },
        "records": {
          "const": "records.jsonl"
        }
      },
      "required": [
        "events",
        "records"
      ],
      "additionalProperties": false
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "record_ref": {
            "type": "string"
          },
          "status": {
            "enum": [
              "embedded",
              "external",
              "remote",
              "missing"
            ]
          },
          "media_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "uri",
          "record_ref",
          "status"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "embedded"
                }
              }
            },
            "then": {
              "required": [
                "sha256",
                "size",
                "path"
              ]
            }
          }
        ]
      }
    },
    "original_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "sha256",
          "size",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "native_records": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "event_kinds": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "native_records",
        "events",
        "event_kinds"
      ],
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "properties": {
        "events.jsonl": {
          "type": "object",
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "sha256",
            "size"
          ],
          "additionalProperties": false
        },
        "records.jsonl": {
          "type": "object",
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "sha256",
            "size"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "events.jsonl",
        "records.jsonl"
      ],
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "format",
    "version",
    "captured_at",
    "source",
    "session",
    "streams",
    "resources",
    "original_files",
    "issues",
    "coverage",
    "integrity",
    "id"
  ],
  "additionalProperties": false
}
