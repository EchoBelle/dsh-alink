{
  "name": "dsh-alink",
  "version": "0.2.1",
  "description": "Import active harness conversations into DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "schemas",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=24.14.0 <25",
    "dsh": "0.2.1-rc.5"
  },
  "packageManager": "pnpm@10.0.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "node scripts/build.mjs",
    "test": "vitest run tests-ts/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm test:package && node scripts/release-smoke.mjs",
    "test:package": "node scripts/check-package.mjs",
    "check:dsh": "node scripts/check-dsh.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-title": "0.2.1-rc.5",
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "ajv": "^8.17.1",
    "lossless-json": "^4.3.0",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-title": "0.2.1-rc.5",
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "esbuild": "^0.25.10",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.2.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "@deepseek-ai/dsh-attachment-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EchoBelle/dsh-alink.git"
  },
  "homepage": "https://github.com/EchoBelle/dsh-alink#readme",
  "bugs": {
    "url": "https://github.com/EchoBelle/dsh-alink/issues"
  },
  "author": "EchoBelle"
}
